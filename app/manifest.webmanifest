{
  "name": "Transskribering",
  "short_name": "Transskribering",
  "description": "Indtal noter, møder og påmindelser, og få et referat på din egen mail.",
  "lang": "da",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f5f8",
  "theme_color": "#f3f5f8",
  "share_target": {
    "action": "./del",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "lyd",
          "accept": ["audio/*", ".m4a", ".mp3", ".wav", ".webm", ".ogg", ".oga", ".aac", ".flac"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
